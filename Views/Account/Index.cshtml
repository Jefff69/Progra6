@model Progra6.Models.UsuarioLogin
@{
    ViewBag.Title = "Index";
}


<h2>Login</h2>

@using (Html.BeginForm("Index", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div>
        <label>Usuario:</label>
        @Html.TextBoxFor(_ => _.LoginName)
    </div>




    <div>
        <label>Password:</label>
        @Html.PasswordFor(_ => _.Password)
    </div>

    if (ViewBag.Error != null)
    {
        <div>
            @ViewBag.Error
        </div>
    }


    <button type="submit">Ingresar</button>

}